{
  "manifest_version": 3,
  "name": "Doomscrolling in the Deep",
  "version": "0.1.0",
  "description": "A gentle, burger-flavoured intervention for addicts that have no shame.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://www.instagram.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_title": "Doomscrolling in the Deep",
    "default_popup": "index.html"
  }
}
