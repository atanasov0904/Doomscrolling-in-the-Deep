{
  "manifest_version": 3,
  "name": "Doomscrolling in the Deep",
  "version": "0.1.0",
  "description": "A gentle, burger-flavoured intervention for YouTube Shorts.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/shorts/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_title": "Doomscrolling in the Deep"
  }
}
